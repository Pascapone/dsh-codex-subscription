{
  "name": "@pascapone/dsh-codex-subscription",
  "version": "2.2.1",
  "packageManager": "pnpm@11.26.0",
  "description": "Use ChatGPT and Codex subscriptions in DeepSeek Harness with OAuth, quota, safe resets, web search, images, and Fast mode",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "DIRECTORY.md",
    "compatibility.json",
    "LICENSE",
    "LICENSE-CODEX-APACHE-2.0",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "icon-subscription.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.shared.json --noEmit && tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.tests.client.json --noEmit",
    "build": "node --experimental-strip-types build.ts",
    "test:behavior": "node --experimental-strip-types build.ts --test && node .test-build/scripts/run-tests.mjs behavior",
    "test:delivery": "node --experimental-strip-types build.ts --test && node .test-build/scripts/run-tests.mjs delivery",
    "test": "node --experimental-strip-types build.ts --test && node --test .test-build/tests/*.test.mjs .test-build/tests/*.test.js",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm pack --pack-destination .artifacts && node --experimental-strip-types scripts/check-package.mts"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "openai-codex",
    "chatgpt-oauth",
    "chatgpt",
    "chatgpt-plus",
    "subscription",
    "quota",
    "quota-reset",
    "fast-mode",
    "usage",
    "oauth",
    "web-search",
    "image-generation"
  ],
  "author": "WSL043",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
