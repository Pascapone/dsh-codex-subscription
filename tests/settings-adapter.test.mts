import test from 'node:test'
import assert from 'node:assert/strict'
import {createSettingsAdapter} from '../src/settings-adapter.js'
test('stable host retains native namespace registration',()=>{const native={get(){return {}},update(){},watch(){}};const ctx={settings:{register:(ns: string,schema: unknown)=>{assert.equal(ns,'codex');assert.equal(schema,'schema');return native}}};assert.deepEqual(createSettingsAdapter((ctx as unknown as Parameters<typeof createSettingsAdapter>[0]),('schema' as unknown as Parameters<typeof createSettingsAdapter>[1]),({} as unknown as Parameters<typeof createSettingsAdapter>[2]),'codex').get(),{})})
test('session speed uses atomic path writes when available',async()=>{const writes: [string, unknown][]=[];const ctx={fiber:{entry:{options:{id:'codex-subscription'}}},settings:{register:()=>({get:()=>({}),update(){},watch(){}}),mutate:async(id: string,ops: unknown)=>writes.push([id,ops])}};await createSettingsAdapter((ctx as unknown as Parameters<typeof createSettingsAdapter>[0]),(null as unknown as Parameters<typeof createSettingsAdapter>[1]),({} as unknown as Parameters<typeof createSettingsAdapter>[2]),'codex-subscription').setSessionSpeed('session-a','fast');assert.deepEqual(writes,[['codex-subscription',[{op:'set',path:['sessionSpeedModes','session-a'],value:'fast'}]]])})
test('new host writes by profile entry id and watches volatile values',async()=>{let value='off',notify: (() => void) | undefined,disposed=false;const writes: [string, unknown][]=[];const ctx={fiber:{entry:{id:'internal-entry',options:{id:'codex-subscription'}}},effect:(fn: () => unknown)=>fn(),on:(event: string,fn: () => void)=>{assert.equal(event,'loader/volatile-update');notify=fn;return()=>{disposed=true}},settings:{configure:()=>()=>{},update:async(id: string,patch: Record<string, string>)=>{writes.push([id,patch]);value=patch.quickQuotaMode;notify?.()}}};const adapter=createSettingsAdapter((ctx as unknown as Parameters<typeof createSettingsAdapter>[0]),(null as unknown as Parameters<typeof createSettingsAdapter>[1]),({quickQuotaMode:{get:()=>value}} as unknown as Parameters<typeof createSettingsAdapter>[2]),'codex-subscription');let latest: Record<string, unknown> | undefined;const stop=adapter.watch(v=>{latest=v});await adapter.update({quickQuotaMode:'bar'});assert.deepEqual(writes,[['codex-subscription',{quickQuotaMode:'bar'}]]);assert.equal(latest!.quickQuotaMode,'bar');assert.equal(adapter.get().quickQuotaMode,'bar');stop();assert.equal(disposed,true)})

test('failed child speed is removed with an atomic unset or the legacy serialized map', async () => {
  const writes: unknown[] = [];
  const native = { get: () => ({ sessionSpeedModes: { parent: 'fast', child: 'fast' } }), update: async (patch: unknown) => { writes.push(patch); }, watch() {} };
  const ctx = { fiber: { entry: { id: 'codex' } }, settings: { register: () => native, mutate: async (_id: string, ops: unknown) => { writes.push(ops); } } };
  const adapter = () => createSettingsAdapter(ctx as unknown as Parameters<typeof createSettingsAdapter>[0], null as unknown as Parameters<typeof createSettingsAdapter>[1], {}, 'codex');
  await adapter().setSessionSpeed('child', undefined);
  assert.deepEqual(writes.pop(), [{ op: 'unset', path: ['sessionSpeedModes', 'child'] }]);
  const legacy = { settings: { register: () => native } };
  await createSettingsAdapter(legacy as unknown as Parameters<typeof createSettingsAdapter>[0], null as unknown as Parameters<typeof createSettingsAdapter>[1], {}, 'codex').setSessionSpeed('child', undefined);
  assert.deepEqual(writes.pop(), { sessionSpeedModes: { parent: 'fast' } });
});
